# Copy to .env to override. No API keys are needed: everything runs locally.
# DATA_DIR=./data
# mock | real   (a missing model or service falls back to the labelled MOCK)
BIOMETRIC_MODE=mock
# LLM_MODE also accepts "offline": acts like a stopped Ollama, to demo UC-12 E3 / UC-14 E4
LLM_MODE=mock
COVER_MODE=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
