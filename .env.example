# Copy to .env to override. No API keys are needed: everything runs locally.
# DATA_DIR=./data
# mock | real   (real modes arrive in Phase 3; missing models fall back to mock)
BIOMETRIC_MODE=mock
LLM_MODE=mock
COVER_MODE=mock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
